@@ -232,6 +243,13 @@ bool Path::is_absolute () const
   if (!_data.empty () && _data[0] == '/')
     return true;
 
+#ifdef _WIN32
+  // Drive-letter paths: C:/ or C:\\ (a bare C: is drive-relative, so not absolute).
+  if (_data.size () >= 3 && std::isalpha (static_cast<unsigned char> (_data[0])) && _data[1] == ':' &&
+      (_data[2] == '/' || _data[2] == '\\'))
+    return true;
